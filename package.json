{
  "name": "eulogy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web && npm run build -w packages/sim",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "sim": "npm run start -w packages/sim --",
    "format": "prettier --write .",
    "demo": "npm run dev -w apps/web -- --host 127.0.0.1",
    "ensemble": "tsx scripts/ensemble.ts",
    "telem": "tsx scripts/telem.ts",
    "band": "tsx scripts/band.ts",
    "runware": "tsx scripts/runware.ts",
    "voices": "tsx scripts/voices.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.15.0",
    "vitest": "^2.1.5"
  }
}
