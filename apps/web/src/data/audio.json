    },
    {
      "cast": "am_fenrir",
      "voice": "am_fenrir",
      "text": "Four months without a call. I still have the voicemail that starts, “Papa, it’s me.”",
      "src": "/audio/chapel/bc0f49d4023d7e72f199224880fdbbd4ca816019997817c9103db291cb0a61ff.mp3",
      "durationMs": 5124,
      "sha256": "cbdd9040f373936e9460d0a64d22f0b49270fc7a59f602140d2e81a5bae87e4b"
    },
    {
      "cast": "bf_emma",
      "voice": "bf_emma",
      "text": "Everyone asks me about the fire. I miss the days he came over with bread.",
      "src": "/audio/chapel/650494f35f49f4ae379b668278c5a1fac807103b7d5d171297e84e3834335fec.mp3",
      "durationMs": 4527,
      "sha256": "405e3681f6775adeb5802b4fdf09bce75e072fc6d3e552fc5b28e8dadfe1131c"
    },
    {
      "cast": "am_puck",
      "voice": "am_puck",
      "text": "He said, “I was wrong,” in front of the whole team. Then he let me speak.",
      "src": "/audio/chapel/d6b8fffa17cc5a7c0fbd2da02d7c5226ceb70461e36bde60ffefcfe31f74f363.mp3",
      "durationMs": 4228,
