    },
    {
      "cast": "af_kore",
      "voice": "af_kore",
      "text": "I kept his seat until the lights went down. At the next recital, he was there before me.",
      "src": "/audio/chapel/d8e15e7b65918fa73a6e73da5a1c6e8c9cddf24ad3e2f1e69f70a8faa5328e1e.mp3",
      "durationMs": 5871,
